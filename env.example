# Copy this file to .env and fill in keys, or use the WebUI tab「API 設定」.
# Never commit .env.

# OpenAI — ASR + review + fallback translation（其餘用程式預設：官方 API、gpt-5.6-luna、xhigh、gpt-4o-transcribe-diarize）
# Review (Sol) always uses this main key. Extra keys below are translation-only.
OPENAI_API_KEY=
# Optional: extra OpenAI keys used only for translation (not ASR, not review). 1→4, 2→7, 3→10 workers.
OPENAI_TRANSLATE_API_KEY=
OPENAI_TRANSLATE_API_KEY_2=

# Fish Audio — TTS（預設用原聲擬合官方英文聲庫約 70 條，自動鎖最接近的一條；對不上才克隆）
FISH_API_KEY=
FISH_API_KEY_2=
FISH_API_URL=https://api.fish.audio/v1/tts
# FISH_VOICE_MATCH=0
# FISH_CLONE=0

# Optional translation knobs (WebUI 一鍵進階也可改)
# DUBBING_WORDS_PER_SEC=2.2
# TRANSLATE_WORKERS=8

# Long-video chunking (optional; defaults keep APIs under their caps)
# DEMUCS_CHUNK_SECONDS=480
# OPENAI_ASR_MAX_SECONDS=1400

# Replicate — cloud Demucs vocal separation
REPLICATE_API_TOKEN=

# Optional: estimated API cost (WebUI shows USD + TWD). Actual invoices may differ.
USD_TWD_RATE=32
OPENAI_INPUT_USD_PER_1M=
OPENAI_OUTPUT_USD_PER_1M=
OPENAI_ASR_USD_PER_MINUTE=0.006
FISH_USD_PER_1M_BYTES=15
REPLICATE_DEMUCS_USD_PER_MINUTE=0.02
